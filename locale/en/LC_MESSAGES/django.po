msgstr "Visit address"

msgid "Documento de identidad"
msgstr "Identity document"

msgid "Documento de identidad. Lo usa el administrador para verificar."
msgstr "Identity document used by the administrator for verification."

msgid "Duracion (horas)"
msgstr "Duration (hours)"

msgid "Duracion (minutos)"
msgstr "Duration (minutes)"

msgid "Duracion de la visita: entre 1 y 4 horas (Business Case 1.1)."
msgstr "Visit duration: between 1 and 4 hours (Business Case 1.1)."

msgid "EMPIEZA AQUÍ"
msgstr "START HERE"

