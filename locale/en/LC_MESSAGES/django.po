msgid ""
"Encuentra profesionales verificados, elige tu horario y reserva servicios "
"para tu hogar en un solo lugar."
msgstr ""
"Find verified professionals, choose a time and book home services in one "
"place."

msgid "Entrar"
msgstr "Sign in"

