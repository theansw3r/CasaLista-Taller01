msgstr "Password (at least 8 characters)"

msgid "Correo"
msgstr "Email"

msgid "Cuenta de acceso. Un usuario tiene como maximo un perfil de cliente."
msgstr "Login account. A user can have at most one customer profile."

msgid "Datos de Open-Meteo"
msgstr "Data by Open-Meteo"

msgid "Debe ser un numero entero mayor o igual a 1."
msgstr "Must be an integer greater than or equal to 1."

msgid "Debe ser uno de: %(medios)s."
msgstr "Must be one of: %(medios)s."

msgid ""
"Describe el servicio con al menos %(v0)s caracteres: el cliente decide con "
"esa informacion."
msgstr ""
"Describe the service in at least %(v0)s characters so customers can make an "
"informed choice."

msgid "Describe tu experiencia"
msgstr "Tell us about your experience"

msgid "Detalle de reserva"
msgstr "Booking detail"

msgid "Detalles de reserva"
msgstr "Booking details"

msgid "Dia"
msgstr "Date"

