msgid ""
"Integración pendiente: falta identificar el equipo aliado y su contrato de "
"API."
msgstr ""
"Integration pending: the partner team and its API contract have not been "
"identified."

msgid "La cantidad de '%(v0)s' debe ser mayor que cero."
msgstr "The quantity of '%(v0)s' must be greater than zero."

