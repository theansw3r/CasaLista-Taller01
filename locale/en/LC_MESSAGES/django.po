msgstr "Weather is unavailable. You can continue your booking."

msgid ""
"El cobro se aprobo pero la reserva no se pudo confirmar. El pago quedo "
"registrado para conciliarlo."
msgstr ""
"The payment was approved but the booking could not be confirmed. The payment"
" was recorded for reconciliation."

msgid "El cuerpo de la peticion debe ser un objeto JSON."
msgstr "The request body must be a JSON object."

msgid "El monto minimo con tarjeta es $ %(v0)s."
msgstr "The minimum card payment is $ %(v0)s."

msgid "El pago solicitado no existe."
msgstr "The requested payment does not exist."

