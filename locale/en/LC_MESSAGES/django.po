msgstr "%(v0)s='%(v1)s' is not a valid value. Available options: %(v2)s."

msgid "1 reserva genera 0..1 pago."
msgstr "1 booking generates 0..1 payment."

msgid "1. Busca un profesional en tu zona"
msgstr "1. Find a professional in your area"

msgid "2. Elige los servicios"
msgstr "2. Choose your services"

msgid "3. Elige un horario disponible"
msgstr "3. Choose an available time"

msgid "4. Confirma la reserva"
msgstr "4. Confirm your booking"

msgid "Abrir un horario"
msgstr "Add availability"

msgid "Accede para gestionar tus reservas y servicios."
msgstr "Sign in to manage your bookings and services."

msgid "Agregacion: 1 profesional ofrece 1..* servicios."
msgstr "Aggregation: 1 professional offers 1..* services."

msgid "Aplicar"
msgstr "Apply"

msgid "Bloque de disponibilidad"
msgstr "Availability slot"

msgid "Bloques de disponibilidad"
msgstr "Availability slots"

msgid "Buscar"
msgstr "Search"

msgid "CasaLista - Catalogo"
msgstr "CasaLista - Catalogue"

msgid "CasaLista - Cuentas"
msgstr "CasaLista - Accounts"

msgid "CasaLista - Pagos"
msgstr "CasaLista - Payments"

msgid "CasaLista - Reservas"
msgstr "CasaLista - Bookings"

msgid ""
"CasaLista solo agenda los cinco oficios del listado, con visitas de entre 1 "
"y 4 horas."
msgstr ""
"CasaLista only schedules the five listed trades, with visits lasting 1 to 4 "
"hours."

msgid ""
"CasaLista solo agenda visitas de hasta %(v0)s minutos (cuatro horas). Un "
"trabajo mas largo se divide en varias visitas."
msgstr ""
"CasaLista schedules visits of up to %(v0)s minutes (four hours). Longer jobs"
" require several visits."

msgid "Cerrajeria"
msgstr "Locksmithing"

msgid "Como se presenta: oficio, experiencia, que trabajos hace."
msgstr "Profile: trade, experience and services offered."

msgid "Consultando el clima…"
msgstr "Checking the weather…"

