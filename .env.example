# Copie este archivo como .env para cambiar el comportamiento de la aplicacion
# SIN tocar el codigo. manage.py lo carga automaticamente al arrancar.
#
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)

# --- Django ----------------------------------------------------------------
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-inseguro-solo-para-desarrollo
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Poner en 1 cuando la aplicacion corra detras del API Gateway: hace que
# Django confie en las cabeceras X-Forwarded-* que el Gateway reenvia.
DJANGO_TRAS_GATEWAY=0

# --- Base de datos ---------------------------------------------------------
# sqlite (por defecto) o postgres. En postgres, SELECT ... FOR UPDATE bloquea
# de verdad, que es lo que el Builder necesita para RN-01 bajo concurrencia.
DB_ENGINE=sqlite
# DB_NAME=casalista
# DB_USER=casalista
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Patron Factory: NotificadorFactory ------------------------------------
# MOCK -> NotificadorConsola  (desarrollo, no envia nada)
# REAL -> NotificadorEmail    (usa el backend de correo de Django)
NOTIFICADOR_TYPE=MOCK

# --- Patron Factory: CalculadorTarifaFactory -------------------------------
# BASE     -> suma de subtotales
# DINAMICA -> recargo nocturno (+20 %) y de fin de semana (+15 %)
TARIFA_TYPE=BASE

# --- Patron Factory: PasarelaPagoFactory -----------------------------------
# SIMULADA -> aprueba siempre, no sale a internet (desarrollo y pruebas)
# TARJETA  -> adaptador de tarjeta
# PSE      -> adaptador de debito bancario
# Con SIMULADA, el medio que pida el cliente se ignora: es la salvaguarda
# para no cobrarle de verdad a nadie mientras se desarrolla.
PASARELA_PAGO_TYPE=SIMULADA

# --- Strangler: microservicio de pagos (Flask) ------------------------------
# Token que manda el servicio de pagos para confirmar reservas por /interno/.
# Tiene que ser el mismo en los dos servicios. Vacio = la ruta queda cerrada.
TOKEN_SERVICIO_PAGOS=
# A donde paga el front. /api/v1/pagos/ (monolito) o /api/v2/pagos/ (Flask,
# solo existe detras de Nginx con docker compose).
URL_PAGOS=/api/v1/pagos/

# --- Reglas de negocio parametrizables -------------------------------------
# Comision de plataforma (Business Case 1.6)
COMISION_PLATAFORMA=0.12

# RN-04: ventanas de cancelacion y porcentaje retenido
HORAS_CANCELACION_LIBRE=24
HORAS_CANCELACION_PARCIAL=2
PENALIZACION_PARCIAL=0.30

# --- Limite de tasa (en produccion lo asume el Gateway) ---------------------
THROTTLE_ANON=60/min
THROTTLE_USER=300/min

# --- Front end de la sustentacion ------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5500

# --- Correo (solo aplica cuando NOTIFICADOR_TYPE=REAL) ---------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@casalista.co
