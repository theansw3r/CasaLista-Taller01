# Copie este archivo como .env (o exporte las variables) para cambiar el
# comportamiento de la aplicacion SIN tocar el codigo.

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-inseguro-solo-para-el-taller

# --- Patron Factory: NotificadorFactory -----------------------------------
# MOCK -> NotificadorConsola  (desarrollo, no envia nada)
# REAL -> NotificadorEmail    (usa el backend de correo de Django)
NOTIFICADOR_TYPE=MOCK

# --- Patron Factory: CalculadorTarifaFactory ------------------------------
# BASE     -> suma de subtotales
# DINAMICA -> recargo nocturno (+20%) y fin de semana (+15%)
TARIFA_TYPE=BASE

# --- Reglas de negocio configurables --------------------------------------
COMISION_PLATAFORMA=0.12

# --- Correo (solo aplica cuando NOTIFICADOR_TYPE=REAL) --------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@casalista.co
